@WAN_PAIR_COMMON@

use crate::config::WanModelConfig;
use crate::pipeline::{denoise_curated, denoise_moe_curated, denoise_moe_curated_swapped, Expert};
use crate::transformer::WanTransformer;
use mlx_gen::{ios_quantum, weights::Weights, CancelFlag, Progress};
use mlx_rs::{random, transforms::eval, Array, DeviceType, Stream};
use std::{
    path::Path,
    sync::{Arc, Mutex},
};

struct Prepared {
    dit: WanTransformer,
    positive: Array,
    negative: Array,
    guidance: f32,
}

impl Prepared {
    fn load(
        root: &Path,
        file: &str,
        cfg: &WanModelConfig,
        inputs: &Weights,
        guidance: f32,
    ) -> mlx_gen::Result<Self> {
        let dit = WanTransformer::from_weights(&Weights::from_file(root.join(file))?, cfg)?;
        let positive = dit.embed_text(inputs.require("positive")?)?;
        let negative = dit.embed_text(inputs.require("negative")?)?;
        eval([&positive, &negative])?;
        Ok(Self {
            dit,
            positive,
            negative,
            guidance,
        })
    }

    fn expert(&self) -> Expert<'_> {
        Expert {
            transformer: &self.dit,
            ctx_cond: self.positive.clone(),
            ctx_uncond: Some(self.negative.clone()),
            guidance: self.guidance,
        }
    }
}

struct Listener;
impl Drop for Listener {
    fn drop(&mut self) {
        ios_quantum::set_quantum_listener(None);
    }
}

#[test]
#[ignore = "model inference; explicit model-proof workflow"]
fn curated_tier1() -> ProofResult<()> {
    let pair = Pair::from_env()?;
    let mut cfg = match pair.case.as_str() {
        "mlx-a14b-t2v-resident-heun" => WanModelConfig::wan22_t2v_14b(),
        "mlx-a14b-i2v-resident-heun" | "mlx-a14b-i2v-swapped-heun" => {
            WanModelConfig::wan22_i2v_14b()
        }
        "mlx-ti2v5b-t2v-heun" => WanModelConfig::wan22_ti2v_5b(),
        _ => return Err("unknown MLX case".into()),
    };
    let stream = Stream::task_local_or_default();
    assert!(matches!(stream.get_device()?.get_type()?, DeviceType::Gpu));
    crate::model_inference_device::record_model_inference_device();
    cfg.num_layers = 1;
    let inputs = Weights::from_file(pair.root.join("inputs.safetensors"))?;
    let shape = [cfg.out_dim as i32, 2, 4, 6];
    let noise = random::normal::<f32>(&shape[..], None, None, Some(&random::key(SEED)?))?;
    let y = if cfg.is_i2v_concat() {
        Some(inputs.require("y")?.clone())
    } else {
        None
    };
    eval([&noise])?;
    if let Some(condition) = &y {
        eval([condition])?;
    }
    let swapped = pair.case == "mlx-a14b-i2v-swapped-heun";
    let (low_cfg, high_cfg) = cfg.sample_guide_scale.resolve_dual(None);
    let load = |high| {
        let (file, guidance) = if !cfg.dual_model {
            ("model.safetensors", cfg.sample_guide_scale.effective())
        } else if high {
            ("high_noise_model.safetensors", high_cfg)
        } else {
            ("low_noise_model.safetensors", low_cfg)
        };
        Prepared::load(&pair.root, file, &cfg, &inputs, guidance)
    };
    // For resident routes, load and project once just as the serving caller does.
    // Sequential reloads/projections happen inside the shipping sampler at the swap.
    let low = (!swapped).then(|| load(false)).transpose()?;
    let high = (cfg.dual_model && !swapped)
        .then(|| load(true))
        .transpose()?;
    let trace = Arc::new(Mutex::new(Vec::new()));
    let observed = Arc::clone(&trace);
    assert!(!ios_quantum::set_quantum_listener(Some(Box::new(
        move |mark| {
            if let ios_quantum::QuantumMark::Metadata {
                provider: "curated",
                kind: "callback_evaluated",
                fields,
            } = mark
            {
                let field = |key| fields.iter().find(|entry| entry.0 == key).unwrap().1;
                observed.lock().unwrap().push(json!({"event":"evaluate",
                "evaluation":field("completed_predict_evaluations"),"sigma_bits":field("sigma_bits")}));
            }
        }
    ))));
    let _listener = Listener;
    let cancel = CancelFlag::new();
    let nt = cfg.num_train_timesteps;
    let boundary = cfg.boundary * nt as f32;
    mlx_rs::memory::reset_peak_memory();
    pair.measure(
        || {
            trace.lock().unwrap().clear();
            let mut progress = |event| {
                if let Progress::Step { current, total } = event {
                    trace.lock().unwrap().push(step(current, total));
                }
            };
            stream.synchronize_and_retire()?;
            let start = Instant::now();
            let latent = if swapped {
                denoise_moe_curated_swapped(
                    boundary,
                    "heun",
                    nt,
                    STEPS,
                    cfg.sample_shift,
                    &noise,
                    y.as_ref(),
                    SEED,
                    &cancel,
                    @WAN_MLX_SWAP_SCOPE@
                    &mut progress,
                    |high| {
                        let e = load(high)?;
                        trace
                            .lock()
                            .unwrap()
                            .push(json!({"event":"load_expert","high":high}));
                        Ok((e.dit, e.positive, Some(e.negative), e.guidance))
                    },
                )?
            } else if let Some(h) = &high {
                denoise_moe_curated(
                    &low.as_ref().unwrap().expert(),
                    &h.expert(),
                    boundary,
                    "heun",
                    nt,
                    STEPS,
                    cfg.sample_shift,
                    &noise,
                    y.as_ref(),
                    SEED,
                    &cancel,
                    &mut progress,
                )?
            } else {
                let e = low.as_ref().unwrap();
                denoise_curated(
                    &e.dit,
                    "heun",
                    nt,
                    STEPS,
                    cfg.sample_shift,
                    e.guidance,
                    &e.positive,
                    Some(&e.negative),
                    &noise,
                    SEED,
                    &cancel,
                    &mut progress,
                )?
            };
            eval([&latent])?;
            stream.synchronize_and_retire()?;
            let elapsed = start.elapsed().as_nanos().try_into()?;
            assert_eq!(latent.shape(), &shape);
            // MLX may return a strided view. Serialize logical C/F/H/W order.
            let values = mlx_gen::array::contiguous(&latent)?.as_slice::<f32>().to_vec();
            Ok((
                elapsed,
                trace.lock().unwrap().clone(),
                shape.map(|x| x as usize).to_vec(),
                values,
            ))
        },
        || Ok(mlx_rs::memory::get_peak_memory() as u64),
    )?;
    println!("\nMODEL_INFERENCE_BODY_COMPLETED wan_pair_fixture::curated_tier1");
    Ok(())
}
