use mlx_gen::{ios_quantum, weights::Weights, CancelFlag, Progress};
use mlx_rs::{transforms::eval, Array, DeviceType, Dtype, Stream};
use std::sync::{Arc, Mutex};

const FQN: &str = "video_pair_fixture::curated_tier1";

fn f32_values(x: &Array) -> ProofResult<Vec<f32>> {
    assert_eq!(x.dtype(), Dtype::Float32);
    Ok(mlx_gen::array::contiguous(x)?.as_slice::<f32>().to_vec())
}

struct Listener;
impl Drop for Listener {
    fn drop(&mut self) {
        ios_quantum::set_quantum_listener(None);
    }
}

fn measure(
    pair: &Pair,
    initial: &Array,
    settings: Value,
    mut denoise: impl FnMut(&mut dyn FnMut(Progress)) -> mlx_gen::Result<Array>,
) -> ProofResult<()> {
    let stream = Stream::task_local_or_default();
    assert!(matches!(stream.get_device()?.get_type()?, DeviceType::Gpu));
    let trace = Arc::new(Mutex::new(Vec::new()));
    let _listener = if settings["sampler"] == "heun" {
        let observed = Arc::clone(&trace);
        assert!(!ios_quantum::set_quantum_listener(Some(Box::new(
            move |event| {
                if let ios_quantum::QuantumMark::Metadata {
                    provider: "curated",
                    kind: "callback_evaluated",
                    fields,
                } = event
                {
                    let field = |name| fields.iter().find(|(key, _)| *key == name).unwrap().1;
                    observed.lock().unwrap().push(json!({"event":"evaluate",
                    "evaluation":field("completed_predict_evaluations"),"sigma_bits":field("sigma_bits")}));
                }
            }
        ))));
        Some(Listener)
    } else {
        None
    };
    eval([initial])?;
    pair.measure(
        f32_values(initial)?,
        settings,
        || {
            trace.lock().unwrap().clear();
            let mut progress = |p| {
                if let Progress::Step { current, total } = p {
                    trace.lock().unwrap().push(step(current, total));
                }
            };
            stream.synchronize_and_retire()?;
            let start = Instant::now();
            let latent = denoise(&mut progress)?;
            eval([&latent])?;
            stream.synchronize_and_retire()?;
            let elapsed = start.elapsed().as_nanos().try_into()?;
            assert!(matches!(
                Stream::task_local_or_default().get_device()?.get_type()?,
                DeviceType::Gpu
            ));
            assert_eq!(latent.shape(), initial.shape());
            Ok((
                elapsed,
                trace.lock().unwrap().clone(),
                latent.shape().iter().map(|&d| d as usize).collect(),
                f32_values(&latent)?,
            ))
        },
        || Ok(mlx_rs::memory::get_peak_memory() as u64),
    )?;
    println!("\nMODEL_INFERENCE_DEVICE {FQN} mlx-metal");
    println!("\nMODEL_INFERENCE_BODY_COMPLETED video_pair_fixture::curated_tier1");
    Ok(())
}
