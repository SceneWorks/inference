// GPU0 Mochi pair 1 only. The model and CUDA inputs remain owned by the caller.
fn mochi_completion(pair: &Pair) -> ProofResult<()> {
    use std::time::{Duration, SystemTime, UNIX_EPOCH};
    let utc_ns = || -> ProofResult<u64> { Ok(SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos().try_into()?) };
    let publish = |name: &str, value: &Value| -> ProofResult<()> {
        let staging = pair.out.join(format!("{name}.pending"));
        let mut file = fs::OpenOptions::new().create_new(true).write(true).open(&staging)?;
        std::io::Write::write_all(&mut file, &serde_json::to_vec(value)?)?;
        file.sync_all()?;
        drop(file);
        let dest = pair.out.join(name);
        assert!(!dest.exists());
        fs::rename(staging, dest)?;
        Ok(())
    };
    let ready = json!({"pid":std::process::id(), "uuid":env::var("CUDA_VISIBLE_DEVICES")?,
                       "case":pair.case, "ready_utc_ns":utc_ns()?});
    publish("mochi-ready.json", &ready)?;
    let started = Instant::now();
    let ack: Value = loop {
        if started.elapsed() >= Duration::from_secs(5) {
            return Err("no fresh owned PDH observation at Mochi completion".into());
        }
        match fs::read(pair.out.join("mochi-ack.json")) {
            Ok(bytes) => {
                assert!(bytes.len() <= 4096);
                break serde_json::from_slice(&bytes)?;
            }
            Err(e) if e.kind() == std::io::ErrorKind::NotFound => std::thread::sleep(Duration::from_millis(10)),
            Err(e) => return Err(e.into()),
        }
    };
    assert_eq!(ack["ready"], ready);
    assert!(ack["sample"][1].as_u64().unwrap_or(0) > 0);
    publish("mochi-release.json", &json!({"ack":ack,"release_utc_ns":utc_ns()?}))
}
