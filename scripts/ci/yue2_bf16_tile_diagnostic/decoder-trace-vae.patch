+    #[test]
+    fn diagnostic_observation_preserves_tiny_full_and_tiled_outputs() {
+        let vae = tiny(VaeVariant::Standard, VaeParts::DecoderOnly);
+        let z = latent_bct();
+        let bits = |x: &Tensor| {
+            x.flatten_all()
+                .unwrap()
+                .to_vec1::<f32>()
+                .unwrap()
+                .into_iter()
+                .map(f32::to_bits)
+                .collect::<Vec<_>>()
+        };
+        let mut seen = Vec::new();
+        let traced = vae
+            .trace_decode_full(&z, &mut |index, input, output| {
+                assert_eq!(input.dtype(), DType::F32);
+                assert_eq!(output.dtype(), DType::F32);
+                seen.push(index);
+                Ok(())
+            })
+            .unwrap();
+        assert_eq!(seen, (0..33).collect::<Vec<_>>());
+        assert_eq!(bits(&traced), bits(&vae.decode_full(&z).unwrap()));
+
+        let mut windows = Vec::new();
+        let traced_tiles = vae
+            .trace_decode_tiled(&z, 3, 16, &mut |window, left, right, stage, _, _| {
+                windows.push((window, left, right, stage));
+                Ok(())
+            })
+            .unwrap();
+        let normal_tiles = vae
+            .decode_tiled(&z, 3, 16, &|| false, &mut |_, _| {})
+            .unwrap();
+        assert_eq!(bits(&traced_tiles), bits(&normal_tiles));
+        assert_eq!(windows.len(), 3 * 33);
+        assert!(windows
+            .iter()
+            .all(|(_, left, right, _)| (*left, *right) == (0, 7)));
+    }
