+    #[test]
+    fn diagnostic_prefix_valid_boundaries_use_original_latent_support() {
+        let vae = tiny(VaeVariant::Standard, VaeParts::DecoderOnly);
+        let valid = |stage: usize, left: i64, right: i64| {
+            let (scale, full_len, _) = vae.trace_prefix_geometry(stage, 75, 0).unwrap();
+            let (_, tile_len, _) = vae
+                .trace_prefix_geometry(stage, (right - left) as usize, 0)
+                .unwrap();
+            let origin = left as usize * scale;
+            let mut indices = (origin..full_len.min(origin + tile_len)).filter(|&index| {
+                let (_, _, (low, high)) = vae.trace_prefix_geometry(stage, 75, index).unwrap();
+                (left == 0 || low >= left) && (right == 75 || high < right)
+            });
+            let first = indices.next().unwrap();
+            (first, indices.last().unwrap_or(first), tile_len)
+        };
+        assert_eq!(valid(0, 0, 32), (0, 28, 32));
+        assert_eq!(valid(0, 16, 64), (19, 60, 48));
+        assert_eq!(valid(0, 48, 75), (51, 74, 27));
+        assert_eq!(valid(2, 16, 64), (117, 362, 288));
+        assert_eq!(valid(3, 16, 64), (120, 359, 288));
+        assert_eq!(valid(4, 16, 64), (129, 350, 288));
+        assert_eq!(valid(5, 16, 64), (156, 323, 288));
+        assert_eq!(valid(7, 16, 64), (782, 1616, 1439));
+        assert_eq!(valid(32, 16, 64), (53487, 100048, 92096));
+        assert_eq!(valid(32, 48, 75), (114927, 143935, 51776));
+        assert_eq!(vae.trace_prefix_geometry(32, 75, 0).unwrap().1, 143936);
+    }
