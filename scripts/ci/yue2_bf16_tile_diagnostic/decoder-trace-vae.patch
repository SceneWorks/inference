+    /// Diagnostic-only observation of the unchanged resident decoder graph. The callback sees
+    /// borrowed native tensors; it never supplies an input to the next layer.
+    pub fn trace_decode_full(
+        &self,
+        z: &Tensor,
+        observer: &mut StageObserver<'_>,
+    ) -> Result<Tensor> {
+        self.check_latent(z)?;
+        Ok(forward_all_observed(
+            &self.decoder,
+            &z.to_device(&self.device)?,
+            Some(observer),
+        )?)
+    }
+
+    /// M3's inclusive original-latent support and output length at one decoder prefix.
+    pub fn trace_prefix_geometry(
+        &self,
+        stage: usize,
+        latent_frames: usize,
+        output_index: usize,
+    ) -> Option<(usize, usize, (i64, i64))> {
+        let prefix = self.decoder.get(..=stage)?;
+        let scale = prefix.iter().fold(1usize, |scale, layer| match layer {
+            Layer::ConvT(c) => scale * c.stride,
+            _ => scale,
+        });
+        let len = output_length(prefix, latent_frames as i64);
+        (output_index < len as usize).then(|| {
+            (
+                scale,
+                len as usize,
+                dependency_interval(prefix, output_index as i64, output_index as i64),
+            )
+        })
+    }
+
+    /// Stable diagnostic names for the source-owned top-level decoder sequence.
+    pub fn trace_stage_kind(&self, stage: usize) -> Option<&'static str> {
+        Some(match self.decoder.get(stage)? {
+            Layer::Snake(_) => "snake",
+            Layer::Conv(_) => "conv",
+            Layer::ConvT(_) => "conv_transpose",
+            Layer::Residual(_) => "residual",
+        })
+    }
+
+    pub fn trace_conv_transpose_padding(&self, stage: usize) -> Option<usize> {
+        match self.decoder.get(stage)? {
+            Layer::ConvT(c) => Some(c.padding),
+            _ => None,
+        }
+    }
+
+    /// Replay only one native M3 layer from independently verified, same-dtype checkpoint input.
+    /// A caller must check replay input/output bits against the original observations.
+    pub fn trace_replay_stage(
+        &self,
+        stage: usize,
+        input: &Tensor,
+        observer: &mut SubstepObserver<'_>,
+    ) -> Result<Tensor> {
+        if input.dtype() != self.dtype || !input.device().same_device(&self.device) {
+            return Err(VaeError::Input(
+                "trace replay input dtype/device differs from resident decoder".into(),
+            ));
+        }
+        let layer = self
+            .decoder
+            .get(stage)
+            .ok_or_else(|| VaeError::Input("trace stage absent".into()))?;
+        Ok(match layer {
+            Layer::Snake(s) => s.forward(input)?,
+            Layer::Conv(c) => c.forward_observed(input, Some(observer))?,
+            Layer::ConvT(c) => c.forward_observed(input, Some(observer))?,
+            Layer::Residual(inner) => {
+                let branch = forward_all_observed(
+                    inner,
+                    input,
+                    Some(&mut |i, _, output| {
+                        observer(
+                            match i {
+                                0 => "inner_snake0",
+                                1 => "inner_conv7",
+                                2 => "inner_snake2",
+                                _ => "inner_conv1",
+                            },
+                            output,
+                        )
+                    }),
+                )?;
+                let added = (&branch + input)?;
+                observer("skip_add", &added)?;
+                added
+            }
+        })
